<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app is signed with the hardened runtime. The bundled Node (V8) compiles JavaScript at
     runtime, which the hardened runtime blocks unless these are allowed. Without them Node
     crashes on its first line of JavaScript (SIGTRAP). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
