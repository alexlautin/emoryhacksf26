{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seatbelt",
  "version": "0.1.0",
  "identifier": "dev.seatbelt.monitor",
  "build": {
    "frontendDist": "loading",
    "beforeDevCommand": "node scripts/stage-desktop.mjs",
    "beforeBuildCommand": "node scripts/stage-desktop.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Watches what AI coding agents do on your computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "build/app/": "app/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
